* B1 -- Ni2 on coronene
* OpenMolcas: SA-CASSCF on the SINGLET (S = 0) manifold
* Requires the corresponding restart orbitals in rasscf_S.RasOrb.

&GATEWAY
 coord = opt_optimized.xyz
 basis = Def2-TZVP
 group = nosym
 amfi
 RICD

&SEWARD

&RASSCF
 fileorb = rasscf_S.RasOrb
 charge = 0
 spin = 1
 nactel = 26 0 0
 inactive = 93
 ras2 = 15
 ciroot = 5 5 1
 thrs = 1.0d-5 1.0d-3 1.0d-3
 iterations = 200 100
 outorbital = canonical
